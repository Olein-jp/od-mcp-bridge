msgid "The Bearer access token does not include the required scope."
msgstr "Bearer アクセストークンに必要な scope が含まれていません。"

msgid "The Bearer access token is invalid or expired."
msgstr "Bearer アクセストークンが無効または期限切れです。"

msgid "The Bearer identity is not available on this site."
msgstr "Bearer のユーザー情報をこのサイトで利用できません。"

msgid "The OAuth access token is invalid."
msgstr "OAuth アクセストークンが無効です。"

msgid "The OAuth signing key is invalid."
msgstr "OAuth 署名鍵が無効です。"

