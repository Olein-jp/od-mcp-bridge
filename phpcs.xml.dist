<?xml version="1.0"?>
<ruleset name="OD MCP Bridge">
	<description>WordPress Coding Standards for OD MCP Bridge.</description>

	<file>od-mcp-bridge.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress"/>
</ruleset>
