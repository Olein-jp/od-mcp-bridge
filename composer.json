{
  "name": "olein-jp/od-mcp-bridge",
  "description": "A minimal WordPress plugin foundation for OD MCP Bridge.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "automattic/jetpack-autoloader": "^5.0",
    "php": ">=7.4",
    "inc2734/wp-github-plugin-updater": "^3.1",
    "wordpress/mcp-adapter": "^0.5.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "automattic/jetpack-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "format": "phpcbf --standard=phpcs.xml.dist",
    "test:integration": "npx --no-install wp-env run tests-cli --env-cwd=wp-content/plugins/od-mcp-bridge ./vendor/bin/phpunit -- -c phpunit.xml.dist",
    "test:oauth:live": "bash scripts/oauth-smoke-test.sh"
  }
}
